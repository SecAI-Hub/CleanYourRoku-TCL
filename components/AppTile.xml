<?xml version="1.0" encoding="utf-8" ?>
<component name="AppTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="showContent" />
        <field id="focusPercent" type="float" onChange="showFocus" />
        <field id="gridHasFocus" type="bool" onChange="showFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/AppTile.brs" />
    <children>
        <Poster id="focus" width="400" height="300" uri="pkg:/images/clean_focus.png" opacity="0" />
        <Poster translation="[5,5]" width="390" height="290" uri="pkg:/images/clean_surface.png" />
        <Poster id="logo" translation="[30,20]" width="340" height="220" loadDisplayMode="scaleToFit" loadingBitmapUri="pkg:/images/clean_placeholder.png" failedBitmapUri="pkg:/images/clean_placeholder.png" />
        <Label id="name" translation="[24,244]" width="352" height="40" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
    </children>
</component>
